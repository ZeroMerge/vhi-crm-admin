PORT=5001
NODE_ENV=development

# Local Postgres or Supabase pooler connection string
DATABASE_URL=postgresql://postgres:<your-db-password>@localhost:5432/vhi_crm
# Production example (use the Supabase session pooler URL from the dashboard)
# DATABASE_URL=postgresql://postgres:<your-db-password>@<your-pooler-host>:5432/postgres

# Realtime notifications (SSE + Postgres LISTEN/NOTIFY)
# LISTEN needs a session-level connection. Leave unset to reuse DATABASE_URL. With Supabase, do NOT use the
# transaction pooler (port 6543 / pgbouncer=true): use a session-mode URL (e.g. the session pooler on port 5432).
# If LISTEN cannot connect, REST keeps working and the apps fall back to polling.
LISTEN_DATABASE_URL=
# Heartbeat comment interval for open streams (ms).
SSE_HEARTBEAT_MS=25000
# Open streams allowed per user (extra connections get 429) and per server process (extra get 503).
SSE_MAX_PER_USER=5
SSE_MAX_CONNECTIONS=1000

# Backend-only secrets
ADMIN_JWT_SECRET=replace-with-a-long-random-secret
CLIENT_JWT_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-project-jwt-secret
# Server-side module permissions: "enforce" (default when unset) returns 403;
# "log" only logs denials as JSON (event=permission_denied) and lets the request through.
# Roll out with log, then switch to enforce once the logs are clean. Account checks always enforce.
PERMISSION_ENFORCEMENT=enforce

JWT_EXPIRES_IN=7d

# Business time zone (IANA name, default Africa/Lagos): used by the scheduler and for every time shown in emails ("15:05 WAT").
# Never the server's own zone. An invalid value stops the server at startup.
APP_TIMEZONE=

# Email (Phase 3: outbox + worker). In production these are checked at startup and the server refuses to start if a
# required one is missing. Provider: "resend" (default in production) or "console" (default elsewhere; logs instead of sending).
EMAIL_PROVIDER=
# Required when EMAIL_PROVIDER is resend.
RESEND_API_KEY=
# Sender, e.g. "VHI <support@your-verified-domain>". Unset = the old hard-coded sender (startup warning in production).
EMAIL_FROM=
# Reply-To for all emails and the inbox that receives customer messages (falls back to SMTP_USER for the inbox, as before).
SUPPORT_EMAIL=
# Required in production: signs unsubscribe links (at least 32 random characters, e.g. `openssl rand -hex 32`).
EMAIL_LINK_SECRET=
# Required in production: public URL of THIS API (unsubscribe links and the List-Unsubscribe header point here).
API_PUBLIC_URL=
# Message emails wait this long and group further messages in the same thread (ms, default 120000).
EMAIL_MESSAGE_BATCH_MS=
# Emails sent in parallel by the worker (default 2).
EMAIL_WORKER_CONCURRENCY=
# Branding (optional; invalid values only log a warning). Colour of buttons/links (#RRGGBB, must keep 4.5:1 contrast with white text).
EMAIL_BRAND_COLOR=
# Absolute https URL of a logo shown in the email header instead of the "VHI" wordmark (about 200x64 px, PNG).
EMAIL_LOGO_URL=
# Postal address printed in every email footer, lines separated by "|" (e.g. "VHI Logistics Ltd | 12 Example Street | Lagos").
EMAIL_COMPANY_ADDRESS=

# Frontend URLs: used for CORS and for every link in emails. Required in production (startup check).
ADMIN_FRONTEND_URL=http://localhost:3000
CLIENT_FRONTEND_URL=http://localhost:5173

# Optional service credentials
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
CLOUDINARY_CLOUD_NAME=xxxx
CLOUDINARY_API_KEY=xxxx
CLOUDINARY_API_SECRET=xxxx

# Production example:
# FRONTEND_URL=https://vhi-crm-admin.vercel.app/
